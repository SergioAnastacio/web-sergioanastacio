---
import AppCard from '../components/AppCard.astro';
import CTA from '../components/CTA.astro';
import HeroSignal from '../components/react/HeroSignal';
import ProjectCard from '../components/ProjectCard.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { apps } from '../data/apps';
import { projects } from '../data/projects';
import { mailto, site } from '../data/site';

const featuredApps = apps.slice(0, 3);
const featuredProjects = projects.slice(0, 2);
---

<SiteLayout title={site.title} description={site.description} path="/">
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-inner">
      <img
        class="profile-photo"
        src={site.avatarUrl}
        alt="Sergio Anastacio"
        width="160"
        height="160"
        decoding="async"
        fetchpriority="high"
      />
      <p class="eyebrow">Software Developer & Mobile Apps</p>
      <h1 id="hero-title">Sergio Anastacio</h1>
      <p class="hero-copy">
        Desarrollo apps móviles, sistemas cloud, automatización e integraciones con IA para productos
        simples de usar y sólidos de operar.
      </p>
      <div class="hero-actions" aria-label="Acciones principales">
        <a class="primary-link" href="/apps">View Apps</a>
        <a class="secondary-link" href="/contact">Contact Me</a>
      </div>
      <HeroSignal client:visible />
    </div>
  </section>

  <section class="section" aria-labelledby="summary-title">
    <div class="section-heading split-heading">
      <div>
        <p class="section-kicker">Personal Brand</p>
        <h2 id="summary-title">Software claro para productos reales.</h2>
      </div>
      <p>
        Este sitio funciona como hub público para apps móviles, soporte, privacidad, portfolio y servicios
        profesionales. El MVP se mantiene estático para ser rápido, simple y fácil de publicar.
      </p>
    </div>
    <div class="feature-grid">
      <article class="feature-card">
        <h3>Mobile Apps</h3>
        <p>Presencia pública para apps en App Store y Google Play, con landing, soporte y privacidad.</p>
      </article>
      <article class="feature-card">
        <h3>Cloud Systems</h3>
        <p>APIs, automatización, despliegues y flujos operativos pensados para crecer sin fricción.</p>
      </article>
      <article class="feature-card">
        <h3>AI Products</h3>
        <p>Integraciones con IA para reducir tareas repetitivas y convertir contexto técnico en acciones.</p>
      </article>
    </div>
  </section>

  <section class="section section-tint" aria-labelledby="apps-title">
    <div class="section-heading split-heading">
      <div>
        <p class="section-kicker">Apps</p>
        <h2 id="apps-title">Apps móviles bajo la marca Sergio Anastacio.</h2>
      </div>
      <a class="secondary-link" href="/apps">Ver todas</a>
    </div>
    <div class="resource-grid">
      {featuredApps.map((app) => <AppCard app={app} />)}
    </div>
  </section>

  <section class="section" aria-labelledby="services-title">
    <div class="section-heading">
      <p class="section-kicker">Services</p>
      <h2 id="services-title">Servicios para clientes, equipos y productos digitales.</h2>
    </div>
    <div class="work-list">
      <article class="work-item">
        <span class="work-index">01</span>
        <div>
          <h3>Mobile App Development</h3>
          <p>Apps iOS y Android con arquitectura limpia, integración de APIs y publicación preparada.</p>
        </div>
      </article>
      <article class="work-item">
        <span class="work-index">02</span>
        <div>
          <h3>Backend APIs & DevOps</h3>
          <p>Servicios .NET, bases de datos, CI/CD, Docker, GitHub Actions y automatización cloud.</p>
        </div>
      </article>
      <article class="work-item">
        <span class="work-index">03</span>
        <div>
          <h3>AI Integration</h3>
          <p>Flujos con IA para soporte, análisis, automatización y productos con asistencia inteligente.</p>
        </div>
      </article>
    </div>
  </section>

  <section class="section section-tint" aria-labelledby="portfolio-title">
    <div class="section-heading split-heading">
      <div>
        <p class="section-kicker">Portfolio</p>
        <h2 id="portfolio-title">Casos técnicos y capacidades de arquitectura.</h2>
      </div>
      <a class="secondary-link" href="/portfolio">Ver portfolio</a>
    </div>
    <div class="resource-grid two-columns">
      {featuredProjects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>

  <CTA
    kicker="Contact"
    title="Hablemos de apps, APIs, automatización o IA."
    body="Para oportunidades profesionales, soporte de apps o colaboración técnica, usa el correo más adecuado."
    primaryHref={mailto(site.emails.contact, 'Contacto desde sergioanastacio.com')}
    primaryLabel={site.emails.contact}
    secondaryHref="/contact"
    secondaryLabel="Ver opciones"
  />
</SiteLayout>
