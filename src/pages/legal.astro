---
import SiteLayout from '../layouts/SiteLayout.astro';
import { apps } from '../data/apps';
import { mailto, site } from '../data/site';
---

<SiteLayout
  title="Legal — Sergio Anastacio"
  description="Centro legal con privacidad, términos, soporte y contacto."
  path="/legal"
>
  <section class="page-hero">
    <p class="eyebrow">Legal</p>
    <h1>Legal and compliance hub.</h1>
    <p>Enlaces centrales para políticas de privacidad, términos, soporte y contacto.</p>
  </section>

  <section class="section compact-section">
    <div class="link-grid">
      <a href="/privacy">Privacy Policies</a>
      <a href="/terms">Terms of Use</a>
      <a href="/support">Support</a>
      <a href="/contact">Contact</a>
      {apps.map((app) => <a href={`/apps/${app.slug}`}>{app.name} App Website</a>)}
    </div>
  </section>

  <section class="section section-tint">
    <div class="section-heading">
      <p class="section-kicker">Contact</p>
      <h2>Correos oficiales.</h2>
    </div>
    <div class="contact-list">
      <a href={mailto(site.emails.contact, 'Contacto legal')}>{site.emails.contact}</a>
      <a href={mailto(site.emails.support, 'Soporte legal')}>{site.emails.support}</a>
      <a href={mailto(site.emails.apps, 'Apps y privacidad')}>{site.emails.apps}</a>
    </div>
  </section>
</SiteLayout>
