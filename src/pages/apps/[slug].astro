---
import CTA from '../../components/CTA.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import type { AppInfo } from '../../data/apps';
import { apps } from '../../data/apps';
import { mailto, site } from '../../data/site';

interface Props {
  app: AppInfo;
}

export function getStaticPaths() {
  return apps.map((app) => ({ params: { slug: app.slug }, props: { app } }));
}

const { app } = Astro.props;
const title = `${app.name} — Sergio Anastacio Apps`;
---

<SiteLayout title={title} description={app.description} path={`/apps/${app.slug}`}>
  <section class="page-hero app-hero">
    <p class="eyebrow">{app.status}</p>
    <h1>{app.name}</h1>
    <p>{app.tagline}</p>
    <div class="hero-actions">
      {
        app.appStoreUrl ? (
          <a class="primary-link" href={app.appStoreUrl} rel="noopener" target="_blank">
            Download on the App Store
          </a>
        ) : (
          <span class="disabled-link">App Store coming soon</span>
        )
      }
      {
        app.googlePlayUrl ? (
          <a class="primary-link" href={app.googlePlayUrl} rel="noopener" target="_blank">
            Get it on Google Play
          </a>
        ) : (
          <span class="disabled-link">Google Play coming soon</span>
        )
      }
    </div>
  </section>

  <section class="section two-panel" aria-labelledby="app-overview">
    <div>
      <p class="section-kicker">Overview</p>
      <h2 id="app-overview">{app.description}</h2>
    </div>
    <div class="detail-panel">
      <h3>Platform availability</h3>
      <div class="meta-row">
        {app.platforms.map((platform) => <span>{platform}</span>)}
      </div>
      <h3>Status</h3>
      <p>{app.status}</p>
    </div>
  </section>

  <section class="section section-tint" aria-labelledby="features-title">
    <div class="section-heading">
      <p class="section-kicker">Features</p>
      <h2 id="features-title">Funciones principales planeadas.</h2>
    </div>
    <div class="feature-grid">
      {
        app.features.map((feature) => (
          <article class="feature-card">
            <p>{feature}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section" aria-labelledby="faq-title">
    <div class="section-heading">
      <p class="section-kicker">FAQ</p>
      <h2 id="faq-title">Preguntas frecuentes.</h2>
    </div>
    <div class="faq-list">
      {
        app.faq.map((item) => (
          <article>
            <h3>{item.question}</h3>
            <p>{item.answer}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section section-tint" aria-labelledby="app-links-title">
    <div class="section-heading">
      <p class="section-kicker">Store URLs</p>
      <h2 id="app-links-title">Enlaces públicos para tiendas y soporte.</h2>
    </div>
    <div class="link-grid">
      <a href={`/privacy/${app.slug}`}>Privacy Policy</a>
      <a href={`/terms/${app.slug}`}>Terms of Use</a>
      <a href={`/support/${app.slug}`}>Support</a>
      <a href={`/apps/${app.slug}/changelog`}>Changelog</a>
    </div>
  </section>

  <CTA
    kicker="App Support"
    title={`Soporte para ${app.name}`}
    body="Para dudas, reportes o información de privacidad, escribe al correo de soporte."
    primaryHref={mailto(site.emails.support, `Soporte ${app.name}`)}
    primaryLabel={site.emails.support}
  />
</SiteLayout>
