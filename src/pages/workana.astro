---
import CTA from '../components/CTA.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { mailto, site } from '../data/site';

const stack = ['C#', '.NET', 'PostgreSQL', 'Docker', 'GitHub Actions', 'Kubernetes', 'Cloudflare', 'Keycloak', 'Mobile Apps', 'AI APIs'];
---

<SiteLayout
  title="Workana — Software Development Services"
  description="Landing profesional para clientes de Workana: apps móviles, APIs, automatización, cloud e integraciones con IA."
  path="/workana"
>
  <section class="page-hero">
    <p class="eyebrow">Workana</p>
    <h1>I help businesses build reliable software.</h1>
    <p>
      Apps móviles, APIs, automatización, infraestructura cloud e integraciones con IA para convertir una
      necesidad de negocio en una solución operable.
    </p>
  </section>

  <section class="section two-panel">
    <div>
      <p class="section-kicker">Process</p>
      <h2>Trabajo con alcance claro, entregables visibles y validación continua.</h2>
    </div>
    <div class="detail-panel">
      <h3>Problemas que resuelvo</h3>
      <ul>
        <li>Crear MVPs publicables.</li>
        <li>Conectar apps móviles con APIs y autenticación.</li>
        <li>Automatizar despliegues y tareas repetitivas.</li>
        <li>Integrar IA en procesos concretos.</li>
      </ul>
    </div>
  </section>

  <section class="section section-tint">
    <div class="section-heading">
      <p class="section-kicker">Stack</p>
      <h2>Tecnologías frecuentes.</h2>
    </div>
    <div class="meta-row large-tags">
      {stack.map((item) => <span>{item}</span>)}
    </div>
  </section>

  <CTA
    title="¿Vienes desde Workana?"
    body="Envíame contexto del proyecto, objetivo, presupuesto estimado y fecha ideal de entrega."
    primaryHref={mailto(site.emails.contact, 'Proyecto desde Workana')}
    primaryLabel={site.emails.contact}
    secondaryHref="/services"
    secondaryLabel="Services"
  />
</SiteLayout>
