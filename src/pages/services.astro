---
import CTA from '../components/CTA.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { mailto, site } from '../data/site';

const services = [
  {
    title: 'Mobile App Development',
    body:
      'Aplicaciones iOS y Android enfocadas en arquitectura limpia, integración de APIs, autenticación y publicación escalable.',
  },
  {
    title: 'Backend APIs with .NET',
    body:
      'APIs robustas con C#, .NET, PostgreSQL, autenticación, observabilidad y automatización de despliegue.',
  },
  {
    title: 'Cloud & DevOps Automation',
    body:
      'Docker, GitHub Actions, Kubernetes, Cloudflare y pipelines que conectan código, configuración y entrega.',
  },
  {
    title: 'AI Integration',
    body:
      'Integración de modelos y APIs de IA para soporte, análisis, asistentes internos y automatización operativa.',
  },
  {
    title: 'Software Architecture',
    body:
      'Diseño técnico para productos que necesitan crecer sin perder claridad, trazabilidad ni mantenibilidad.',
  },
  {
    title: 'Technical Consulting',
    body:
      'Acompañamiento para diagnosticar problemas, definir ruta técnica y convertir ideas en entregables publicables.',
  },
];
---

<SiteLayout
  title="Services — Sergio Anastacio"
  description="Servicios de desarrollo de software: apps móviles, APIs .NET, automatización cloud, IA, arquitectura y consultoría técnica."
  path="/services"
>
  <section class="page-hero">
    <p class="eyebrow">Services</p>
    <h1>Software services for reliable products.</h1>
    <p>
      Desarrollo soluciones digitales para negocios y equipos que necesitan apps, APIs, automatización e
      integraciones con IA.
    </p>
  </section>

  <section class="section compact-section">
    <div class="feature-grid">
      {services.map((service) => <article class="feature-card"><h2>{service.title}</h2><p>{service.body}</p></article>)}
    </div>
  </section>

  <CTA
    kicker="Start"
    title="Cuéntame qué necesitas construir."
    body="Describe el problema, plataforma objetivo, fechas importantes y cualquier stack existente."
    primaryHref={mailto(site.emails.contact, 'Servicios de software')}
    primaryLabel={site.emails.contact}
    secondaryHref="/portfolio"
    secondaryLabel="Ver portfolio"
  />
</SiteLayout>
