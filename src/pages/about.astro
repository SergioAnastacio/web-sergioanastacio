---
import CTA from '../components/CTA.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { mailto, site } from '../data/site';
---

<SiteLayout
  title="About — Sergio Anastacio"
  description="Perfil profesional de Sergio Anastacio: desarrollo móvil, arquitectura backend, DevOps, automatización e IA."
  path="/about"
>
  <section class="page-hero">
    <p class="eyebrow">About</p>
    <h1>Software developer focused on useful systems.</h1>
    <p>
      Soy desarrollador de software enfocado en apps móviles, arquitectura backend, automatización DevOps y
      sistemas con IA.
    </p>
  </section>

  <section class="section two-panel">
    <div>
      <p class="section-kicker">Profile</p>
      <h2>Me interesa construir software que sea claro para usuarios y operable para equipos técnicos.</h2>
    </div>
    <div class="detail-panel">
      <p>
        Trabajo conectando producto, arquitectura y despliegue: desde interfaces móviles hasta APIs,
        automatizaciones, infraestructura y flujos de entrega.
      </p>
      <p>
        Mi enfoque es pragmático: entender el problema, reducir fricción, publicar rápido y dejar una base
        que pueda mantenerse.
      </p>
    </div>
  </section>

  <section class="section section-tint">
    <div class="section-heading">
      <p class="section-kicker">Interests</p>
      <h2>Áreas técnicas.</h2>
    </div>
    <div class="feature-grid">
      <article class="feature-card"><h2>Mobile</h2><p>Apps iOS/Android, APIs, autenticación y publicación.</p></article>
      <article class="feature-card"><h2>Backend</h2><p>.NET, PostgreSQL, arquitectura y servicios internos.</p></article>
      <article class="feature-card"><h2>Automation</h2><p>CI/CD, DevOps, GitHub Actions, Cloudflare e IA aplicada.</p></article>
    </div>
  </section>

  <CTA
    title="Conecta conmigo."
    primaryHref={mailto(site.emails.contact, 'Contacto profesional')}
    primaryLabel={site.emails.contact}
    secondaryHref={site.githubUrl}
    secondaryLabel="GitHub"
  />
</SiteLayout>
