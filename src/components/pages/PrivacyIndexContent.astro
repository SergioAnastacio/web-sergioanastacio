---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { apps } from '../../data/apps';
import { getLangFromUrl, getLocalizedPath } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const en = lang === 'en';
const lp = (p: string) => getLocalizedPath(p, lang);
---

<SiteLayout
  title="Privacy Policies — Sergio Anastacio"
  description={en ? 'Privacy policies for apps and products by Sergio Anastacio.' : 'Políticas de privacidad para apps y productos de Sergio Anastacio.'}
  path={Astro.url.pathname}
>
  <section class="page-hero">
    <p class="eyebrow">{en ? 'Privacy Policies' : 'Políticas de Privacidad'}</p>
    <h1>{en ? 'Privacy policies by product.' : 'Políticas de privacidad por producto.'}</h1>
    <p>{en ? 'Select an app to review its data practices, support and contact.' : 'Selecciona una app para consultar sus prácticas de datos, soporte y contacto.'}</p>
  </section>

  <section class="section compact-section">
    <div class="link-grid">
      {apps.map((app) => <a href={lp(`/privacy/${app.slug}`)}>{app.name} {en ? 'Privacy Policy' : 'Política de Privacidad'}</a>)}
    </div>
  </section>
</SiteLayout>
