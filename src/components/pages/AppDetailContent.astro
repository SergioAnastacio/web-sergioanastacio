---
import CTA from '../CTA.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import type { AppInfo } from '../../data/apps';
import { mailto, site } from '../../data/site';
import { getLangFromUrl, useTranslations, getLocalizedPath } from '../../i18n/utils';

interface Props {
  app: AppInfo;
}

const { app } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const lp = (p: string) => getLocalizedPath(p, lang);
const title = `${app.name} — Sergio Anastacio Apps`;
const statusLabel = app.concept ? t('concept.badge') : app.status;
const en = lang === 'en';
---

<SiteLayout title={title} description={app.description} path={Astro.url.pathname}>
  <section class="page-hero app-hero">
    <p class="eyebrow">{statusLabel}</p>
    <h1>{app.name}</h1>
    <p>{app.tagline}</p>
    {
      app.concept && (
        <p class="concept-notice">{t('concept.notice')}</p>
      )
    }
    <div class="hero-actions">
      {
        app.appStoreUrl ? (
          <a class="primary-link" href={app.appStoreUrl} rel="noopener" target="_blank">
            {en ? 'Download on the App Store' : 'Descargar en App Store'}
          </a>
        ) : (
          <span class="disabled-link">{en ? 'App Store — link pending release' : 'App Store — enlace disponible al release'}</span>
        )
      }
      {
        app.googlePlayUrl ? (
          <a class="primary-link" href={app.googlePlayUrl} rel="noopener" target="_blank">
            {en ? 'Get it on Google Play' : 'Disponible en Google Play'}
          </a>
        ) : (
          <span class="disabled-link">{en ? 'Google Play — link pending release' : 'Google Play — enlace disponible al release'}</span>
        )
      }
    </div>
  </section>

  <section class="section two-panel" aria-labelledby="app-overview">
    <div>
      <p class="section-kicker">{en ? 'Overview' : 'Resumen'}</p>
      <h2 id="app-overview">{en ? 'What it is' : 'Qué es'}</h2>
      <p class="lead">{app.description}</p>
    </div>
    <div class="detail-panel">
      <h3 class="h5">{en ? 'Platform availability' : 'Plataformas'}</h3>
      <div class="meta-row">
        {app.platforms.map((platform) => <span>{platform}</span>)}
      </div>
      <h3 class="h5">{en ? 'Status' : 'Estado'}</h3>
      <p>{statusLabel}</p>
    </div>
  </section>

  <section class="section section-tint" aria-labelledby="features-title">
    <div class="section-heading">
      <p class="section-kicker">{en ? 'Features' : 'Funciones'}</p>
      <h2 id="features-title">{en ? 'Planned core features.' : 'Funciones principales planeadas.'}</h2>
    </div>
    <div class="feature-grid">
      {app.features.map((feature) => <article class="feature-card"><p>{feature}</p></article>)}
    </div>
  </section>

  <section class="section" aria-labelledby="faq-title">
    <div class="section-heading">
      <p class="section-kicker">FAQ</p>
      <h2 id="faq-title">{en ? 'Frequently asked questions.' : 'Preguntas frecuentes.'}</h2>
    </div>
    <div class="faq-list">
      {app.faq.map((item) => (
        <article>
          <h3>{en && item.questionEn ? item.questionEn : item.question}</h3>
          <p>{en && item.answerEn ? item.answerEn : item.answer}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section section-tint" aria-labelledby="app-links-title">
    <div class="section-heading">
      <p class="section-kicker">{en ? 'Store URLs' : 'Enlaces'}</p>
      <h2 id="app-links-title">{en ? 'Public links for stores and support.' : 'Enlaces públicos para tiendas y soporte.'}</h2>
    </div>
    <div class="link-grid">
      <a href={lp(`/privacy/${app.slug}`)}>{en ? 'Privacy Policy' : 'Política de Privacidad'}</a>
      <a href={lp(`/terms/${app.slug}`)}>{en ? 'Terms of Use' : 'Términos de Uso'}</a>
      <a href={lp(`/support/${app.slug}`)}>{en ? 'Support' : 'Soporte'}</a>
      <a href={lp(`/apps/${app.slug}/changelog`)}>{en ? 'Changelog' : 'Changelog'}</a>
    </div>
  </section>

  <CTA
    kicker={en ? 'App Support' : 'Soporte de App'}
    title={en ? `Support for ${app.name}` : `Soporte para ${app.name}`}
    body={en ? 'For questions, reports or privacy info, write to the support email.' : 'Para dudas, reportes o información de privacidad, escribe al correo de soporte.'}
    primaryHref={mailto(site.emails.support, `Soporte ${app.name}`)}
    primaryLabel={site.emails.support}
  />
</SiteLayout>
