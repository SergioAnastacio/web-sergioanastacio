---
import CTA from '../CTA.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import type { ProductInfo } from '../../data/products';
import { getProductKnownIssues } from '../../data/products';
import { mailto, site } from '../../data/site';
import { getLangFromUrl, getLocalizedPath, getProductPath } from '../../i18n/utils';

interface Props {
  product: ProductInfo;
}

const { product } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const en = lang === 'en';
const lp = (p: string) => getLocalizedPath(p, lang);
const knownIssues = getProductKnownIssues(product, en);
---

<SiteLayout
  title={`Support for ${product.name} — Sergio Anastacio`}
  description={en ? `Support, FAQ and known issues for ${product.name}.` : `Soporte, preguntas frecuentes e incidencias conocidas de ${product.name}.`}
  path={Astro.url.pathname}
>
  <section class="page-hero">
    <p class="eyebrow">{en ? 'Product Support' : 'Soporte de producto'}</p>
    <h1>{en ? 'Support for' : 'Soporte para'} {product.name}</h1>
    <p>{en ? 'Support info, FAQ and product legal links.' : 'Información de soporte, preguntas frecuentes y enlaces legales del producto.'}</p>
  </section>

  <section class="section two-panel">
    <div>
      <p class="section-kicker">FAQ</p>
      <h2>{en ? 'Common questions.' : 'Preguntas comunes.'}</h2>
    </div>
    <div class="faq-list">
      {product.faq.map((item) => (
        <article>
          <h3>{en && item.questionEn ? item.questionEn : item.question}</h3>
          <p>{en && item.answerEn ? item.answerEn : item.answer}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section section-tint">
    <div class="section-heading">
      <p class="section-kicker">{en ? 'Known Issues' : 'Incidencias'}</p>
      <h2>{en ? 'Known issues.' : 'Incidencias conocidas.'}</h2>
    </div>
    <ul class="clean-list">{knownIssues.map((issue) => <li>{issue}</li>)}</ul>
  </section>

  <section class="section">
    <div class="section-heading">
      <p class="section-kicker">{en ? 'Links' : 'Enlaces'}</p>
      <h2>{en ? 'Privacy and terms.' : 'Privacidad y términos.'}</h2>
    </div>
    <div class="link-grid">
      <a href={lp(`/privacy/${product.slug}`)}>{en ? 'Privacy Policy' : 'Política de Privacidad'}</a>
      <a href={lp(`/terms/${product.slug}`)}>{en ? 'Terms of Use' : 'Términos de Uso'}</a>
      <a href={getProductPath(product.slug, lang)}>{en ? 'Product Website' : 'Sitio del producto'}</a>
    </div>
  </section>

  <CTA
    title={en ? `Contact ${product.name} support` : `Contactar soporte de ${product.name}`}
    body={en ? 'Include the platform, product version if known, steps to reproduce and screenshots if applicable.' : 'Incluye plataforma, versión del producto si la conoces, pasos para reproducir el problema y capturas si aplica.'}
    primaryHref={mailto(site.emails.support, `Soporte ${product.name}`)}
    primaryLabel={site.emails.support}
  />
</SiteLayout>
