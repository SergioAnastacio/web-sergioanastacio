---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { products } from '../../data/products';
import { mailto, site } from '../../data/site';
import { getLangFromUrl, getLocalizedPath } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const en = lang === 'en';
const lp = (p: string) => getLocalizedPath(p, lang);
---

<SiteLayout
  title="Support — Sergio Anastacio"
  description={en ? 'Support hub for products by Sergio Anastacio.' : 'Centro de soporte para productos de Sergio Anastacio.'}
  path={Astro.url.pathname}
>
  <section class="page-hero">
    <p class="eyebrow">{en ? 'Support' : 'Soporte'}</p>
    <h1>{en ? 'Support for products.' : 'Soporte para productos.'}</h1>
    <p>{en ? 'Choose a product or write directly to the support email.' : 'Elige un producto o escribe directamente al correo de soporte.'}</p>
    <div class="hero-actions">
      <a class="primary-link" href={mailto(site.emails.support, en ? 'General support' : 'Soporte general')}>
        {site.emails.support}
      </a>
    </div>
  </section>

  <section class="section compact-section">
    <div class="link-grid">
      {products.map((product) => <a href={lp(`/support/${product.slug}`)}>{en ? 'Support for' : 'Soporte de'} {product.name}</a>)}
    </div>
  </section>
</SiteLayout>
