---
import CTA from '../CTA.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import type { AppInfo } from '../../data/apps';
import { mailto, site } from '../../data/site';
import { getLangFromUrl, getLocalizedPath } from '../../i18n/utils';

interface Props {
  app: AppInfo;
}

const { app } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const en = lang === 'en';
const lp = (p: string) => getLocalizedPath(p, lang);
---

<SiteLayout
  title={`Privacy Policy for ${app.name} — Sergio Anastacio`}
  description={en ? `Privacy policy for ${app.name}.` : `Política de privacidad para ${app.name}.`}
  path={Astro.url.pathname}
>
  <section class="page-hero">
    <p class="eyebrow">{en ? 'Privacy Policy' : 'Política de Privacidad'}</p>
    <h1>{en ? 'Privacy Policy for' : 'Política de Privacidad de'} {app.name}</h1>
    <p>{en ? 'Last updated:' : 'Última actualización:'} {app.privacy.lastUpdated}</p>
  </section>

  <section class="section legal-copy">
    <h2>{en ? 'Introduction' : 'Introducción'}</h2>
    <p>{app.privacy.introduction}</p>
    <h2>{en ? 'Information collected' : 'Información recopilada'}</h2>
    <ul>{app.privacy.collected.map((item) => <li>{item}</li>)}</ul>
    <h2>{en ? 'How information is used' : 'Uso de la información'}</h2>
    <ul>{app.privacy.usage.map((item) => <li>{item}</li>)}</ul>
    <h2>{en ? 'Data storage' : 'Almacenamiento de datos'}</h2>
    <p>{app.privacy.storage}</p>
    <h2>{en ? 'Third-party services' : 'Servicios de terceros'}</h2>
    <ul>{app.privacy.thirdPartyServices.map((item) => <li>{item}</li>)}</ul>
    <h2>{en ? "Children's privacy" : 'Privacidad infantil'}</h2>
    <p>{app.privacy.children}</p>
    <h2>{en ? 'User rights and contact' : 'Derechos del usuario y contacto'}</h2>
    <p>{app.privacy.rights}</p>
  </section>

  <CTA
    title={en ? 'Have a privacy question?' : '¿Tienes una pregunta de privacidad?'}
    primaryHref={mailto(site.emails.apps, `Privacidad ${app.name}`)}
    primaryLabel={site.emails.apps}
    secondaryHref={lp(`/support/${app.slug}`)}
    secondaryLabel={en ? 'Support' : 'Soporte'}
  />
</SiteLayout>
