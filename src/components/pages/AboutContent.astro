---
import CTA from '../CTA.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { mailto, site } from '../../data/site';
import { getLangFromUrl, useTranslations, getLocalizedPath } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const lp = (p: string) => getLocalizedPath(p, lang);
---

<SiteLayout
  title={lang === 'en' ? 'About — Sergio Anastacio' : 'Acerca — Sergio Anastacio'}
  description={t('about.hero.copy')}
  path={Astro.url.pathname}
>
  <section class="page-hero">
    <p class="eyebrow">{t('about.hero.eyebrow')}</p>
    <h1>{t('about.hero.title')}</h1>
    <p>{t('about.hero.copy')}</p>
  </section>

  <section class="section two-panel">
    <div>
      <p class="section-kicker">{t('about.profile.kicker')}</p>
      <h2>{t('about.profile.title')}</h2>
    </div>
    <div class="detail-panel">
      <p>{t('about.profile.p1')}</p>
      <p>{t('about.profile.p2')}</p>
    </div>
  </section>

  <section class="section section-tint">
    <div class="section-heading">
      <p class="section-kicker">{t('about.interests.kicker')}</p>
      <h2>{t('about.interests.title')}</h2>
    </div>
    <div class="feature-grid">
      <article class="feature-card"><h2>Mobile</h2><p>{lang === 'en' ? 'iOS/Android apps, APIs, authentication and publishing.' : 'Apps iOS/Android, APIs, autenticación y publicación.'}</p></article>
      <article class="feature-card"><h2>Backend</h2><p>.NET, PostgreSQL, {lang === 'en' ? 'architecture and internal services.' : 'arquitectura y servicios internos.'}</p></article>
      <article class="feature-card"><h2>Automation</h2><p>{lang === 'en' ? 'CI/CD, DevOps, GitHub Actions, Cloudflare and applied AI.' : 'CI/CD, DevOps, GitHub Actions, Cloudflare e IA aplicada.'}</p></article>
    </div>
  </section>

  <CTA
    title={t('about.cta.title')}
    primaryHref={mailto(site.emails.contact, lang === 'en' ? 'Professional contact' : 'Contacto profesional')}
    primaryLabel={site.emails.contact}
    secondaryHref={site.githubUrl}
    secondaryLabel="GitHub"
  />
</SiteLayout>
