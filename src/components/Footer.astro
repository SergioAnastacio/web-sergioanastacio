---
import { mailto, site } from '../data/site';
import { getLangFromUrl, useTranslations, getLocalizedPath, getProductsPath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const lp = (path: string) => getLocalizedPath(path, lang);

const groups = [
  {
    title: t('footer.products'),
    links: [
      { label: t('nav.products'), href: getProductsPath(lang) },
      { label: 'Support', href: lp('/support') },
      { label: 'Privacy', href: lp('/privacy') },
    ],
  },
  {
    title: t('footer.professional'),
    links: [
      { label: t('nav.portfolio'), href: lp('/portfolio') },
      { label: t('nav.services'), href: lp('/services') },
      { label: t('nav.about'), href: lp('/about') },
      { label: t('nav.contact'), href: lp('/contact') },
    ],
  },
  {
    title: t('footer.legal'),
    links: [
      { label: 'Terms', href: lp('/terms') },
      { label: 'Legal', href: lp('/legal') },
      { label: 'GitHub', href: site.githubUrl, external: true },
    ],
  },
];
---

<footer class="site-footer">
  <div class="footer-main">
    <div class="footer-brand">
      <a class="brand" href={lp('/')} aria-label="Sergio Anastacio">SA</a>
      <p>{t('footer.tagline')}</p>
      <a href={mailto(site.emails.contact, 'Contacto desde sergioanastacio.com')}>
        {site.emails.contact}
      </a>
    </div>

    <nav class="footer-groups" aria-label="Navegación de pie de página">
      {
        groups.map((group) => (
          <div class="footer-group">
            <h2 class="h6">{group.title}</h2>
            {group.links.map((link) => (
              <a
                href={link.href}
                rel={link.external ? 'me noopener' : undefined}
                target={link.external ? '_blank' : undefined}
              >
                {link.label}
              </a>
            ))}
          </div>
        ))
      }
    </nav>
  </div>

  <div class="footer-bottom">
    <span>&copy; {new Date().getFullYear()} Sergio Anastacio. {t('footer.rights')}</span>
    <span>{t('footer.built')}</span>
  </div>
</footer>
