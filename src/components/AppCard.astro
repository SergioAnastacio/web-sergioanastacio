---
import type { AppInfo } from '../data/apps';
import { getLangFromUrl, useTranslations, getLocalizedPath } from '../i18n/utils';

interface Props {
  app: AppInfo;
}

const { app } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const lp = (p: string) => getLocalizedPath(p, lang);
const statusClass = app.concept ? 'concept-pill' : 'status-pill';
const statusData = app.concept ? 'Concept' : app.status;
const statusLabel = app.concept ? t('concept.badge') : app.status;
---

  <article class="resource-card app-card">
    <div class="card-header">
      <p class={statusClass} data-status={statusData}>{statusLabel}</p>
      <h3 class="h4"><a href={lp(`/apps/${app.slug}`)}>{app.name}</a></h3>
    </div>
    <p>{app.description}</p>
    <div class="meta-row" aria-label={lang === 'en' ? `Platforms for ${app.name}` : `Plataformas para ${app.name}`}>
      {app.platforms.map((platform) => <span>{platform}</span>)}
    </div>
    <div class="card-links">
      <a href={lp(`/apps/${app.slug}`)}>{t('card.viewapp')}</a>
      <a href={lp(`/privacy/${app.slug}`)}>{t('card.privacy')}</a>
      <a href={lp(`/support/${app.slug}`)}>{t('card.support')}</a>
    </div>
  </article>
