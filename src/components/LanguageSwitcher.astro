---
import { getLangFromUrl, getAlternatePath, languages, type Lang } from '../i18n/utils';

const currentLang = getLangFromUrl(Astro.url);
const otherLang: Lang = currentLang === 'es' ? 'en' : 'es';
const otherHref = getAlternatePath(Astro.url.pathname, otherLang);
---

<a
  class="lang-switch"
  href={otherHref}
  aria-label={`Switch to ${languages[otherLang]}`}
>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="10" />
    <path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
  </svg>
  <span class="lang-switch__current">{languages[currentLang]}</span>
  <span class="lang-switch__sep">/</span>
  <span class="lang-switch__other">{languages[otherLang]}</span>
</a>
